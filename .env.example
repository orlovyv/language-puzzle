DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/language_puzzle
HOST=0.0.0.0
PORT=3000
APP_SECRET=change-me-local-secret

# Connection pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Demo account seeded on startup
DEMO_EMAIL=demo@local.ru
DEMO_PASSWORD=123

# Translation / transcription
USE_GOOGLETRANS_FALLBACK=1
GOOGLETRANS_SOURCE_LANG=en
GOOGLETRANS_TARGET_LANG=ru
USE_IPA_TRANSCRIPTION=1
USE_WORDNET_FALLBACK=0

# Email transport for verification codes and temporary passwords.
# Priority: Brevo HTTPS API (if BREVO_API_KEY set) -> SMTP -> stdout (dev).
#
# Brevo over HTTPS (port 443) — use this when the host blocks outbound SMTP
# ports. SMTP_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=
SMTP_FROM=noreply@language-puzzle.local
SMTP_FROM_NAME=Language Puzzle
#
# SMTP fallback (only used when BREVO_API_KEY is empty).
# Leave SMTP_HOST empty in dev — codes/passwords are then printed to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
# Require a 6-digit email code at registration (user is created only after verify).
EMAIL_VERIFICATION_ENABLED=1

# --- Cloudflare Turnstile ("я не робот"). Off => captcha skipped (dev/tests) ---
# Test keys work without a domain: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
USE_TURNSTILE=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AI enrichment (OpenRouter), premium only. Off => free fallback everywhere ---
USE_AI_FEATURES=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=20
AI_DAILY_LIMIT_FREE=0
AI_DAILY_LIMIT_PREMIUM=300

# --- URL import & language guard ---
# Import article text from a web link on the Upload screen (trafilatura main
# text + BeautifulSoup alternative blocks). Set USE_URL_IMPORT=0 to disable.
USE_URL_IMPORT=1
URL_FETCH_TIMEOUT=15
URL_FETCH_MAX_BYTES=3000000
# Reject confidently non-English uploads (pasted text, files, URL blocks).
REQUIRE_ENGLISH_TEXT=1

# --- Billing mode ---
# donation (default): AI features are free for everyone; the Premium screen
#   becomes a voluntary "support the developer" donation form and the Premium
#   nav button is hidden.
# subscription: legacy paid Premium scheme (AI gated behind an active sub).
BILLING_MODE=donation
DONATION_MIN_RUB=50
DONATION_DEFAULT_RUB=200
DONATION_MAX_RUB=100000

# --- Billing. Active provider: robokassa (default) or yookassa ---
# Empty keys for the active provider => checkout returns 503.
PAYMENT_PROVIDER=robokassa
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_RETURN_URL=http://localhost:3000/settings

# Robokassa (active by default)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=1
ROBOKASSA_BASE_URL=https://auth.robokassa.ru/Merchant/Index.aspx

# YooKassa (kept, inactive unless PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Admin panel access: comma-separated emails. Empty => no admins ---
ADMIN_EMAILS=
