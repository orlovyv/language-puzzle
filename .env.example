DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/language_puzzle
HOST=0.0.0.0
PORT=3000
APP_SECRET=change-me-local-secret

# Connection pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Demo account seeded on startup
DEMO_EMAIL=demo@local.ru
DEMO_PASSWORD=123

# Translation / transcription
USE_GOOGLETRANS_FALLBACK=1
GOOGLETRANS_SOURCE_LANG=en
GOOGLETRANS_TARGET_LANG=ru
USE_IPA_TRANSCRIPTION=1
USE_WORDNET_FALLBACK=0

# Email verification (off by default; codes are printed to stdout when SMTP is unset)
EMAIL_VERIFICATION_ENABLED=0

# --- AI enrichment (OpenRouter), premium only. Off => free fallback everywhere ---
USE_AI_FEATURES=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=20
AI_DAILY_LIMIT_FREE=0
AI_DAILY_LIMIT_PREMIUM=300

# --- Billing (YooKassa). Empty keys => checkout returns 503 ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_RETURN_URL=http://localhost:3000/settings
