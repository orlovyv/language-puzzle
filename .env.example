DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/language_puzzle
HOST=0.0.0.0
PORT=3000
APP_SECRET=change-me-local-secret

# Connection pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Demo account seeded on startup
DEMO_EMAIL=demo@local.ru
DEMO_PASSWORD=123

# Translation / transcription
USE_GOOGLETRANS_FALLBACK=1
GOOGLETRANS_SOURCE_LANG=en
GOOGLETRANS_TARGET_LANG=ru
USE_IPA_TRANSCRIPTION=1
USE_WORDNET_FALLBACK=0

# Email: SMTP for verification codes and temporary passwords.
# Leave SMTP_HOST empty in dev — codes/passwords are then printed to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@language-puzzle.local
SMTP_FROM_NAME=Language Puzzle
SMTP_USE_TLS=1
# Require a 6-digit email code at registration (user is created only after verify).
EMAIL_VERIFICATION_ENABLED=1

# --- Cloudflare Turnstile ("я не робот"). Off => captcha skipped (dev/tests) ---
# Test keys work without a domain: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
USE_TURNSTILE=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AI enrichment (OpenRouter), premium only. Off => free fallback everywhere ---
USE_AI_FEATURES=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=20
AI_DAILY_LIMIT_FREE=0
AI_DAILY_LIMIT_PREMIUM=300

# --- Billing. Active provider: robokassa (default) or yookassa ---
# Empty keys for the active provider => checkout returns 503.
PAYMENT_PROVIDER=robokassa
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_RETURN_URL=http://localhost:3000/settings

# Robokassa (active by default)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=1
ROBOKASSA_BASE_URL=https://auth.robokassa.ru/Merchant/Index.aspx

# YooKassa (kept, inactive unless PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Admin panel access: comma-separated emails. Empty => no admins ---
ADMIN_EMAILS=
